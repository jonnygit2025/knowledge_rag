# Copiare in .env. Non committare .env.
POSTGRES_PASSWORD=knowledge
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@localhost:5432/knowledge
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
YOUTUBE_API_KEY=
DEMO_MODE=true
STARTUP_SYNC=true
SYNC_INTERVAL_MINUTES=60
# demo: vettori deterministici, senza download di modelli né chiamate esterne.
# Per ricerca semantica: openai-compatible (configurare chiave e limite > 0).
EMBEDDING_PROVIDER=demo
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Vuoto = passaggi citati; un modello abilita la generazione opzionale.
LLM_MODEL=
MAX_PAID_CALLS_PER_DAY=0
CONFIG_FILE=config.yaml
EXPORT_DIR=data/exports
IMPORT_DIR=data/imports
